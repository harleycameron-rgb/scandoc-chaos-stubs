{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scandoc-silhouette-v1",
  "title": "Silhouette",
  "type": "object",
  "required": [
    "id",
    "kind",
    "version",
    "rule_version",
    "outline",
    "completeness",
    "semantic_payload",
    "sentinel"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "silhouette"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rule_version": {
      "type": "string",
      "const": "scandoc-silhouette-invariants/v1"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "outline": {
      "type": "object",
      "required": [
        "motif"
      ],
      "properties": {
        "motif": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "number"
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residue_mark": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "completeness": {
      "const": "intentionally_incomplete"
    },
    "semantic_payload": {
      "type": "null"
    },
    "carrier_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "sentinel": {
      "type": "string",
      "minLength": 128,
      "maxLength": 128,
      "pattern": "^[0-9a-f]{128}$"
    },
    "geometry": {
      "type": "object",
      "required": [
        "model",
        "seed",
        "delta",
        "arm_count",
        "formula",
        "arms"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "geometry"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "const": "sil_tentacled_geometry_default"
          },
          "outline": {
            "properties": {
              "motif": {
                "const": "tentacled_sphere_geometry"
              }
            }
          }
        }
      }
    }
  ]
}
